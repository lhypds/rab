PORT=3016
PM2_NAME=rab
# The only credential rab needs: a public Mapbox token for the map.
VITE_MAPBOX_TOKEN=
# Where a reader who has forgotten their password is told to write (optional).
VITE_ADMIN_EMAIL=
# Fills in a new item's form from its photo, for the iPhone app (optional):
# without it the form is left to be filled in by hand.
OPENAI_API_KEY=
# Which OpenAI model looks at the photo (optional; gpt-4o-mini where unset).
RAB_DESCRIBE_MODEL=
# Whether rab uses email: 1 to turn it on. Off where unset. So far it means
# that signing up asks for an email address and a verification code mailed to
# it — without it an account is a name and a password. Turning it on needs the
# mail settings below.
ENABLE_EMAIL=
# Mail, for the code that proves an address at sign-up, sent through Amazon
# SES. The region SES is set up in, a key allowed ses:SendEmail, and the
# address it is sent from (verified in SES). Without them a server that is
# being worked on prints the code on its console, and one in production
# refuses to open accounts.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAB_MAIL_FROM=
