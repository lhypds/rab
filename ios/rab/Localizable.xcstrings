{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ — %@" : {
      "shouldTranslate" : false
    },
    "Add to my items on rab" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab のマイアイテムに登録" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登记到 rab 的我的物品" } }
      }
    },
    "Area" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エリア" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "地区" } }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } }
      }
    },
    "Choose a password" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワードを決める" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置密码" } }
      }
    },
    "Choose a photo" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真を選ぶ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择照片" } }
      }
    },
    "Continue" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次へ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续" } }
      }
    },
    "Create account" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アカウントを作成" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建账号" } }
      }
    },
    "Delete" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } }
      }
    },
    "Delete this item?" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このアイテムを削除しますか？" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除这个物品？" } }
      }
    },
    "Deletes it from this phone. On rab it stays until you take it down there." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この iPhone から削除します。rab 上のものは、rab で取り下げるまで残ります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只从这台手机上删除。rab 上的那一份要在 rab 里下架才会消失。" } }
      }
    },
    "Give it a name" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前を入れてください" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请填写名称" } }
      }
    },
    "It is not in your items on rab yet: %@. You can add it from the item's page." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab のマイアイテムにはまだ登録されていません：%@。アイテムのページから登録できます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有登记到 rab 的我的物品：%@。可以在物品页面里再登记。" } }
      }
    },
    "Description" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "説明" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "描述" } }
      }
    },
    "Kind" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "種類" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "种类" } }
      }
    },
    "My items" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マイアイテム" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我的物品" } }
      }
    },
    "Name" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "名称" } }
      }
    },
    "New item" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいアイテム" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新物品" } }
      }
    },
    "No account is called %@. Choose a password of 6 characters or more to create it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ というアカウントはありません。6文字以上のパスワードを決めて作成します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有叫 %@ 的账号。设置一个 6 位以上的密码即可创建。" } }
      }
    },
    "No subject was found in the photo" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真の中に被写体が見つかりません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "照片里没有找到主体" } }
      }
    },
    "Nothing yet" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "まだ何もありません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有物品" } }
      }
    },
    "OK" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OK" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好" } }
      }
    },
    "On this phone only, in your folder under data." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この iPhone だけにあります。data の下の自分のフォルダに。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只在这台手机上，放在 data 下你的文件夹里。" } }
      }
    },
    "Open on rab" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab で開く" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 rab 上打开" } }
      }
    },
    "Password" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密码" } }
      }
    },
    "Please sign in" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サインインしてください" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先登录" } }
      }
    },
    "Price" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "料金" } },
