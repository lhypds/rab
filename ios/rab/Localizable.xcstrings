    },
    "Removing the background…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "背景を消しています…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在去除背景…" } }
