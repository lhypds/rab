    "Category" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カテゴリ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "分类" } }
      }
    },
    "Recognizing the photo…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真を認識しています…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在识别照片…" } }
      }
    },
    "This could not be filled in from the photo. Fill it in yourself." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真から自動入力できませんでした。手動で入力してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法根据照片自动填写，请手动填写。" } }
      }
    },
    "This server is not set up to fill this in from the photo." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このサーバーでは写真からの自動入力が設定されていません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台服务器还没有设置根据照片自动填写。" } }
      }
    },
    "on this phone" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この iPhone のみ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在手机" } }
      }
    },
    "Chosen for you: you are within 100 m of it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動で選びました。この場所から 100 m 以内にいます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已为你自动选择：你在它 100 米以内。" } }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定を開く" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开设置" } }
      }
    },
    "The area the location is in." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "その場所のあるエリアです。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该位置所在的地区。" } }
      }
    },
    "The area you are in. Attach a location to offer it somewhere else." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今いるエリアです。別のエリアで提供するには、場所を指定してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你当前所在的地区。要在别处提供，请指定一个位置。" } }
      }
    },
    "rab needs to know where you are to say which area it is offered in. Allow location in Settings, or attach a location." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "提供エリアを決めるには現在地が必要です。設定で位置情報を許可するか、場所を指定してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "rab 需要你的位置来确定服务地区。请在设置中允许位置，或指定一个位置。" } }
      }
    },
    "rab could not tell which area you are in. Attach a location, or try again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のエリアがわかりませんでした。場所を指定するか、もう一度お試しください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "rab 无法确定你所在的地区。请指定一个位置，或重试。" } }
      }
    },
    "rab needs your location: it is the area a new item is offered in." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab には現在地が必要です。新しいアイテムの提供エリアになります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "rab 需要你的位置：它是新物品的服务地区。" } }
      }
    }
  },
  "version" : "1.0"
}
