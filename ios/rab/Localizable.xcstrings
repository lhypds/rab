    "Take a photo" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真を撮る" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拍照" } }
      }
    },
    "Taken" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "撮影" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拍摄于" } }
      }
    },
    "That is not a web address" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウェブアドレスではありません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这不是一个网址" } }
      }
    },
    "The background could not be removed: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "背景を消せませんでした：%@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法去除背景：%@" } }
      }
    },
    "The photo could not be read" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真を読み込めません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取照片" } }
      }
    },
    "Username" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ユーザー名" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用户名" } }
      }
    },
    "Verification code" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証コード" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "验证码" } }
      }
    },
    "Welcome back, %@." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "おかえりなさい、%@。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "欢迎回来，%@。" } }
      }
    },
    "Your items stay in your folder on this phone." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アイテムはこの iPhone の自分のフォルダに残ります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的物品会留在这台手机上你的文件夹里。" } }
      }
    },
    "rab could not tell which area you are in. Allow location and try again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のエリアがわかりませんでした。位置情報を許可して、もう一度お試しください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "rab 无法确定你所在的地区。请允许使用位置后再试。" } }
      }
    },
    "Location" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "場所" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "位置" } }
      }
    },
    "None" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "なし" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无" } }
      }
    },
    "Add a new location" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しい場所を追加" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加新位置" } }
      }
    },
    "New location" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しい場所" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新位置" } }
      }
    },
    "Add" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "追加" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加" } }
      }
    },
    "A location needs a name" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "場所には名前が必要です" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "位置需要一个名称" } }
      }
    },
    "Move the map until the pin is on the place. What is attached to it is shown there on rab's map." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ピンがその場所に重なるまで地図を動かしてください。この場所に紐づけたものは rab の地図上でそこに表示されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移动地图，让图钉落在这个地点上。附加到它的东西会显示在 rab 地图上的这个位置。" } }
      }
    },
    "Your items could not be loaded from rab: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab からアイテムを読み込めませんでした：%@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法从 rab 加载你的物品：%@" } }
      }
    },
    "It is deleted from rab for good, and any open bookings of it are cancelled." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "rab から完全に削除され、進行中の予約はすべてキャンセルされます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "它会从 rab 上永久删除，尚未结束的预订也会被取消。" } }
      }
    },
    "Background" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "背景" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "背景" } }
      }
    },
