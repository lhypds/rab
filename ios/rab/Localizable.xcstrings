      }
    },
    "No account is called %@. Choose a password of 6 characters or more to create it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ というアカウントはありません。6文字以上のパスワードを決めて作成します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有叫 %@ 的账号。设置一个 6 位以上的密码即可创建。" } }
      }
    },
    "No account is called %@. Choose a password of 6 characters or more, and give an email address: a verification code is sent to it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ というアカウントはありません。6文字以上のパスワードとメールアドレスを入力してください。認証コードをメールで送ります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有叫 %@ 的账号。请设置 6 位以上的密码并填写邮箱，验证码会发到这个邮箱。" } }
      }
    },
