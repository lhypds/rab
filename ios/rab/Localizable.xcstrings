    "Delete this item?" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このアイテムを削除しますか？" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除这个物品？" } }
      }
    },
    "Deletes it from this phone. On rab it stays until you take it down there." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この iPhone から削除します。rab 上のものは、rab で取り下げるまで残ります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只从这台手机上删除。rab 上的那一份要在 rab 里下架才会消失。" } }
      }
    },
    "Email" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メールアドレス" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "邮箱" } }
      }
    },
    "Enter the 6-digit code sent to %@." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ に送った6桁のコードを入力してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入发送到 %@ 的 6 位验证码。" } }
